# KinyaBot backend — Agent V1 additions (merge into your existing .env)
# NOTHING here is required: every value has a safe built-in default.
# Full list: backend/services/agent/config.js

# --- Agent core -----------------------------------------------------------
# AGENT_ENABLED=true                      # master switch (false = 503 on /api/agent/*)
# AGENT_EXECUTION_MODE=local              # V1: local forked workers. 'remote' is V2.
# AGENT_PROVIDER=groq                     # 'groq' (production) — 'scripted' is TEST-ONLY

# --- Models (reuse your existing Groq models by default) -------------------
# AGENT_MODEL=openai/gpt-oss-20b
# AGENT_PLANNING_MODEL=openai/gpt-oss-20b

# --- Orchestration & limits (defaults in parentheses) ----------------------
# AGENT_MAX_CONCURRENT_TASKS=2            # global running workers (2)
# AGENT_TASK_DAILY_LIMIT=50               # per user per day (50)
# AGENT_TASK_TIMEOUT_MS=600000            # max task duration (10 min)
# AGENT_MAX_STEPS=40                      # loop steps before honest STEP_LIMIT (40)
# AGENT_MAX_TOOL_RETRIES=2                # retries with backoff for transient errors (2)
# AGENT_COMMAND_TIMEOUT_MS=120000         # per shell command (2 min)
# AGENT_CONFIRMATION_TIMEOUT_MS=300000    # high-risk approval window, then auto-deny (5 min)
# AGENT_STUCK_WORKER_MS=90000             # watchdog kills silent workers (90 s)
# AGENT_WORKSPACE_CLEANUP_MIN=240         # idle workspace + preview reaping (4 h)

# --- Preview (§24) ---------------------------------------------------------
# AGENT_PREVIEW_ENABLED=true
# AGENT_PREVIEW_TOKEN_TTL=3600000         # signed iframe token lifetime (1 h)
# AGENT_PREVIEW_PROBE_MS=1200             # live port probe timeout

# --- Workspaces -------------------------------------------------------------
# AGENT_WORKSPACE_ROOT=                   # default: <backend>/agent-workspaces

# --- TEST ONLY (never set in production) ------------------------------------
# KINYA_ALLOW_SCRIPTED_PROVIDER=1         # lets the scripted provider run outside NODE_ENV=test
