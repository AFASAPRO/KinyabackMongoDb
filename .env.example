# Server
PORT=5000
# Public site URL used in emails/links. Production: FRONTEND_URL=https://kinyabotai.online
FRONTEND_URL=http://localhost:5173
# Optional extra CORS/Socket.IO origins, comma-separated (production origins
# https://kinyabotai.online and https://www.kinyabotai.online are built in)
#ALLOWED_ORIGINS=

# MongoDB Atlas (replace with your connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kinyabot?retryWrites=true&w=majority

# JWT (change in production!)
JWT_SECRET=kinyabot_super_secret_jwt_key_change_this_now_2024
ADMIN_SECRET=admin_jwt_secret_different_from_user_secret

# AI APIs (server-side only — NEVER expose these to the frontend)
GROQ_API_KEY=your_groq_api_key_here
# Model per capability (Chat uses GROQ_CHAT_MODEL, falling back to legacy GROQ_MODEL)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# LangSearch Web Search API (server-side only — PRO feature, Web Search)
# Get a free key at https://langsearch.com → API Dashboard. Without a
# key the Web Search feature reports "not configured" and never calls
# the API; normal chat keeps working.
LANGSEARCH_API_KEY=
# Optional overrides (defaults shown)
#LANGSEARCH_ENDPOINT=https://api.langsearch.com/v1/web-search
#LANGSEARCH_TIMEOUT_MS=12000
#LANGSEARCH_COUNT=8
#LANGSEARCH_TEXT_MAX_CHARS=3200

# Optional limits / rate limiting (defaults shown)
#MAX_IMAGE_SIZE=4194304
#MAX_DOCUMENT_SIZE=15728640
#MAX_AUDIO_SIZE=15728640
#AI_CONTEXT_MAX_MESSAGES=20
#AI_CONTEXT_TOKEN_BUDGET=6000
#RL_CHAT_LIMIT=20
#RL_UPLOAD_LIMIT=12
#RL_STT_LIMIT=20
#RL_TTS_LIMIT=30

# SMTP Email (Gmail example - use App Password for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="KinyaBot AI <your@gmail.com>"

# Admin credentials (change these!)
ADMIN_EMAIL=admin@kinyabot.ai
ADMIN_PASSWORD=KinyaBot@Admin2024

# Admin invite code for registering additional admins
ADMIN_INVITE_CODE=KinyaBot-Admin-2024

# Google OAuth 2.0 (Continue with Google) — server-side only, NEVER put the secret in the frontend.
# Create an OAuth client (type: Web application) in Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must EXACTLY equal GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Production: https://backendkiny1.onrender.com/api/auth/google/callback
# Local dev : http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Web Push (Superadmin PWA) — generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kinyabot.ai
